+// MeshThatWorks: distributed (layer-split) inference primitive.
+//
+// A `MeshSplittable` model executes only a contiguous slice of its transformer
+// layers, so a model can be pipelined across devices. With a per-session KV
+// cache threaded through each call, this supports multi-token generation:
+// prefill the prompt, then decode token-by-token, each node maintaining the KV
+// cache for ONLY its layers.
+//
+// Works for slice-loaded nodes across architectures (Qwen3 dense + MoE, Llama):
+// `layerOffset` = the node's slice start. For MoE, the node additionally streams
+// only its slice's experts from SSD (expert tensorName remapped to the original
+// layer index) — SSD streaming × mesh split combined.
+
+import Foundation
+import MLX
+import MLXLMCommon
+import MLXNN
+
+public protocol MeshSplittable {
+    /// Run only the layers whose original index is in `start..<end`, using the
+    /// supplied per-layer KV cache (one entry per locally-held layer).
+    /// - fromTokens: input is token IDs (first peer embeds them); else it's the
+    ///   activation from the previous peer.
+    /// Returns `[batch, seq, hidden]`, or logits `[batch, seq, vocab]` when this
+    /// slice owns the final layer.
+    func meshLayerForward(
+        _ input: MLXArray, fromTokens: Bool, start: Int, end: Int, cache: [KVCache]?
+    ) -> MLXArray
+}
+
+func meshRunSplit<Mask>(
+    _ input: MLXArray,
+    fromTokens: Bool,
+    start: Int,
+    end: Int,
+    layerOffset: Int,
+    totalLayers: Int,
+    layerCount: Int,
+    cache: [KVCache]?,
+    embed: (MLXArray) -> MLXArray,
+    makeMask: (MLXArray, [KVCache]?) -> Mask,
+    runLayer: (Int, MLXArray, Mask, KVCache?) -> MLXArray,
+    finalNorm: (MLXArray) -> MLXArray,
+    head: (MLXArray) -> MLXArray
+) -> MLXArray {
+    var h: MLXArray
+    if fromTokens {
+        h = embed(input)
+    } else {
+        // Activation crossed the wire as fp32; cast back to the model's compute
+        // dtype so this slice matches a single-node pass (else argmax drifts).
+        let dtype = embed(MLXArray([Int32(0)])).dtype
+        h = input.asType(dtype)
+    }
+    let mask = makeMask(h, cache)
+    // Local indices of layers whose ORIGINAL index falls in [start, end).
+    let lo = max(0, start - layerOffset)
+    let hi = min(layerCount, end - layerOffset)
+    var i = lo
+    while i < hi {
+        h = runLayer(i, h, mask, cache?[i])
+        i += 1
+    }
+    if end >= totalLayers {
+        h = head(finalNorm(h))
+    }
+    return h
+}
+
+extension Qwen3Model: MeshSplittable {
+    public func meshLayerForward(
+        _ input: MLXArray, fromTokens: Bool, start: Int, end: Int, cache: [KVCache]?
+    ) -> MLXArray {
+        meshRunSplit(
+            input, fromTokens: fromTokens, start: start, end: end,
+            layerOffset: model.meshOffset, totalLayers: model.meshTotal,
+            layerCount: model.layers.count, cache: cache,
+            embed: { model.embedTokens($0) },
+            makeMask: { createAttentionMask(h: $0, cache: $1?.first) },
+            runLayer: { model.layers[$0]($1, mask: $2, cache: $3) },
+            finalNorm: { model.norm($0) },
+            head: { lmHead != nil ? lmHead!($0) : model.embedTokens.asLinear($0) }
+        )
+    }
+}
+
+extension Qwen3MoEModel: MeshSplittable {
+    public func meshLayerForward(
+        _ input: MLXArray, fromTokens: Bool, start: Int, end: Int, cache: [KVCache]?
+    ) -> MLXArray {
+        meshRunSplit(
+            input, fromTokens: fromTokens, start: start, end: end,
+            layerOffset: model.meshOffset, totalLayers: model.meshTotal,
+            layerCount: model.layers.count, cache: cache,
+            embed: { model.embedTokens($0) },
+            makeMask: { createAttentionMask(h: $0, cache: $1?.first) },
+            runLayer: { model.layers[$0]($1, mask: $2, cache: $3) },
+            finalNorm: { model.norm($0) },
+            head: { lmHead != nil ? lmHead!($0) : model.embedTokens.asLinear($0) }
+        )
+    }
+}
+
+extension LlamaModel: MeshSplittable {
+    public func meshLayerForward(
+        _ input: MLXArray, fromTokens: Bool, start: Int, end: Int, cache: [KVCache]?
+    ) -> MLXArray {
+        meshRunSplit(
+            input, fromTokens: fromTokens, start: start, end: end,
+            layerOffset: model.meshOffset, totalLayers: model.meshTotal,
+            layerCount: model.layers.count, cache: cache,
+            embed: { model.embedTokens($0) },
+            makeMask: { createAttentionMask(h: $0, cache: $1?.first) },
+            runLayer: { model.layers[$0]($1, mask: $2, cache: $3) },
+            finalNorm: { model.norm($0) },
+            head: { lmHead != nil ? lmHead!($0) : model.embedTokens.asLinear($0) }
+        )
+    }
+}
