+
+// MeshThatWorks: per-node layer-range loading.
+//
+// When `MTW_LAYER_RANGE=start,end` is set, a node creates and loads ONLY the
+// transformer layers in `[start, end)`. Guarded entirely by the env var, so the
+// normal single-node path is unchanged.
+
+/// Parsed `MTW_LAYER_RANGE`, clamped to `[0, total]`; full range if unset.
+public func meshLayerRange(total: Int) -> (start: Int, end: Int) {
+    guard let raw = ProcessInfo.processInfo.environment["MTW_LAYER_RANGE"] else {
+        return (0, total)
+    }
+    let parts = raw.split(separator: ",")
+    guard parts.count == 2,
+        let s = Int(parts[0].trimmingCharacters(in: .whitespaces)),
+        let e = Int(parts[1].trimmingCharacters(in: .whitespaces))
+    else { return (0, total) }
+    return (max(0, min(s, total)), max(0, min(e, total)))
+}
+
+public var meshLayerRangeActive: Bool {
+    ProcessInfo.processInfo.environment["MTW_LAYER_RANGE"] != nil
+}
+
+/// Drop out-of-range `…layers.N…` weights and shift in-range indices down by
+/// `start`, so they line up with a model that created only its slice.
+public func meshRemapLayerWeights(_ weights: [String: MLXArray]) -> [String: MLXArray] {
+    guard meshLayerRangeActive else { return weights }
+    let (start, end) = meshLayerRange(total: Int.max)
+    var out = [String: MLXArray]()
+    out.reserveCapacity(weights.count)
+    for (key, value) in weights {
+        guard let n = meshLayerIndex(in: key) else {
+            out[key] = value  // non-layer weight (embed/norm/lm_head) — keep
+            continue
+        }
+        if n < start || n >= end { continue }
+        out[key.replacingOccurrences(of: ".layers.\(n).", with: ".layers.\(n - start).")] = value
+    }
+    return out
+}
+
+private func meshLayerIndex(in key: String) -> Int? {
+    guard let r = key.range(of: ".layers.") else { return nil }
+    let digits = key[r.upperBound...].prefix { $0.isNumber }
+    return digits.isEmpty ? nil : Int(digits)
+}
+
+/// Shift a key's `.layers.N.` index by `delta` (used to map a sliced node's
+/// 0-based module path back to the original safetensors layer index).
+func meshShiftLayerIndex(_ key: String, by delta: Int) -> String {
+    guard let n = meshLayerIndex(in: key) else { return key }
+    return key.replacingOccurrences(of: ".layers.\(n).", with: ".layers.\(n + delta).")
+}
