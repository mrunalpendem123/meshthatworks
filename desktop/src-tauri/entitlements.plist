<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <!-- MLX / Metal compile shaders and JIT at runtime. -->
  <key>com.apple.security.cs.allow-jit</key>
  <true/>
  <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
  <true/>
  <!-- The app spawns the separately-built SwiftLM binary; without this the
       hardened runtime refuses to load/launch it. -->
  <key>com.apple.security.cs.disable-library-validation</key>
  <true/>
  <!-- mtw sets env vars (e.g. SWIFTLM_TOP_K, MTW_*) for the SwiftLM child. -->
  <key>com.apple.security.cs.allow-dyld-environment-variables</key>
  <true/>
</dict>
</plist>
